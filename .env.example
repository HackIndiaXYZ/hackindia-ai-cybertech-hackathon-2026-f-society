# -------------------------------------------------------------
# CodeLens AI Environment Configuration
# -------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key"

# Server Port (default is 3000)
PORT=3000

# Server Host (default is 0.0.0.0 for container / cloud hosting compatibility)
HOST="0.0.0.0"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# Application URL (used for internal references; defaults to http://localhost:PORT)
APP_URL="http://localhost:3000"
